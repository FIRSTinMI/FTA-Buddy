# --- Firebase Auth ---
# Local dev: point the Admin SDK at the emulator (started by docker compose).
# Leave this UNSET in production so the real Firebase project is used.
FIREBASE_AUTH_EMULATOR_HOST='localhost:9099'
FIREBASE_PROJECT_ID='fta-buddy'
# Production only: full service-account JSON inline (Admin SDK credential).
# Leave empty locally. Alternatively set GOOGLE_APPLICATION_CREDENTIALS to a file path.
FIREBASE_SERVICE_ACCOUNT=''

REDIS_URL='redis://localhost:6379'
DB_HOST='localhost'
DB_USER='user'
DB_PASSWORD='password'
DB_NAME='ftabuddy'
DB_PORT='5432'
TBA_API_KEY='tba_api_key'
GOOGLE_CLIENT_ID='google_client_id'
VAPID_PUBLIC_KEY='vapid_public_key'
VAPID_PRIVATE_KEY='vapid_private_key'
TOA_KEY='toa_key'
TOA_APP_NAME='ftabuddy'
FTC_KEY='user:ftc_key'
GOOGLE_KEY='google_key'
GOOGLE_PROJECT_ID='google_project_id'
GOOGLE_KEY_ID='google_key_id'
GOOGLE_KEY_CLIENT='google_key_client'
SLACK_CLIENT_ID='slack_bot'
SLACK_CLIENT_SECRET='slack_secret'
OPENAI_KEY='openai_key'
OPENAI_MODEL='gpt-4o-mini'
GCS_BUCKET='your-gcs-bucket-name'
NEXUS_WEBHOOK_TOKEN=''

# --- Troubleshooting assistant (Claude Opus 4.8) ---
# Anthropic API key. Leave empty to disable the chat assistant entirely.
ANTHROPIC_API_KEY=''
# Hard monthly spend cap in USD, tracked in Redis. Default 50.
TROUBLESHOOT_MONTHLY_CAP_USD='50'
# Kill switch. Default true. Admins can also flip it at runtime via troubleshoot.setEnabled.
TROUBLESHOOT_CHAT_ENABLED='true'

# --- Troubleshooting corpus: Slack history poller ---
# Copies CSA channel threads into the corpus every 3 hours (plus or minus 30 min). One instance runs it (Redis leader lock).
TROUBLESHOOT_SLACK_POLL_ENABLED='true'
# Gap between Slack API calls in ms. conversations.history/replies are Tier 3 (about 50 per minute).
TROUBLESHOOT_SLACK_REQUEST_GAP_MS='1300'
# Messages per history/replies page. Slack caps some non-Marketplace apps at 15; lower this if calls error.
TROUBLESHOOT_SLACK_PAGE_SIZE='200'
# User-scope OAuth redirect. Must match a Redirect URL in the Slack app config exactly.
SLACK_USER_REDIRECT_URI='https://ftabuddy.com/slack/user-oauth/callback'
# Where the browser goes after connecting. The app opens Settings when ?slack= is present.
SLACK_USER_RETURN_URL='https://ftabuddy.com/'
