# Frontend (Vite) env. Copy to app/.env.local for overrides.
#
# In dev mode the app automatically uses the local Firebase Auth emulator at
# http://localhost:9099 (started by `docker compose up`). You normally do NOT
# need to set anything here.
#
# Override the emulator URL:
# VITE_FIREBASE_AUTH_EMULATOR='http://localhost:9099'
#
# Force the REAL Firebase project even in dev (e.g. to test Google sign-in):
# VITE_FIREBASE_AUTH_EMULATOR=''
