    "content_scripts": [
        {
            "run_at": "document_end",
            "matches": [
                "http://10.0.100.5/FieldMonitor*",
                "http://localhost/FieldMonitor*"
            ],
            "js": [
                "injector.js"
            ]
        },
        {
            "run_at": "document_end",
            "matches": [
                "http://10.0.100.5/displays/field_monitor*",
                "http://localhost/displays/field_monitor*"
            ],
            "js": [
                "cheesy-inject.js"
            ]
        },
        {
            "run_at": "document_end",
            "matches": [
                "https://ftabuddy.com/*",
                "https://dev.ftabuddy.com/*",
                "http://localhost:5173/*"
            ],
            "js": [
                "app.js"
            ]
        },
        {
            "run_at": "document_end",
            "matches": [
                "https://frc.nexus/*"
            ],
            "js": [
                "nexus.js"
            ]
        },
        {
            "run_at": "document_end",
            "matches": [
                "http://localhost/*"
            ],
            "js": [
                "vivid.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "injected-fieldmonitor.js",
                "injected-overlay.js",
                "img/logo.png"
            ],
            "matches": [
                "http://10.0.100.5/*",
                "http://localhost/*"
            ]
        },
        {
            "resources": [
                "injected-nexus.js"
            ],
            "matches": [
                "https://frc.nexus/*"
            ]
        },
        {
            "resources": [
                "injected-vivid.js"
            ],
            "matches": [
                "http://localhost/*"
            ]
        }
    ],
    "icons": {
        "48": "img/logo48.png",
        "128": "img/logo128.png"
    },
    "action": {
        "default_popup": "menu.html",
        "default_icon": "img/logo.png"
    },
    "background": {
        "service_worker": "background.js"
    }
}
